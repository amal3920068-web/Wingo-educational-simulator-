        # PUBLIC RESULT
        # ====================================================

        result_title = Label(
            text="RESULT",
            bold=True,
            size_hint_y=None,
            height=30
        )

        content.add_widget(result_title)

        self.result_label = Label(
            text="Waiting...",
            font_size=18,
            bold=True,
            size_hint_y=None,
            height=40
