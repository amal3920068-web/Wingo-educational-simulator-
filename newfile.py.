            spacing=8,
            size_hint_y=None,
            height=50
        )

        self.red_button = Button(
            text="RED",
            font_size=16
        )

        self.green_button = Button(
            text="GREEN",
            font_size=16
        )

        self.violet_button = Button(
            text="VIOLET",
            font_size=16
        )

        colour_layout.add_widget(self.red_button)
        colour_layout.add_widget(self.green_button)
        colour_layout.add_widget(self.violet_button)

        content.add_widget(colour_layout)

        # Fill colour buttons
        self.set_button_color(
