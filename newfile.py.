import secrets
import json
import os

from kivy.app import App
from kivy.clock import Clock
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.gridlayout import GridLayout
from kivy.uix.label import Label
from kivy.uix.button import Button
from kivy.uix.anchorlayout import AnchorLayout
from kivy.graphics import Color, RoundedRectangle


# ============================================================
# WIN GO EDUCATIONAL SIMULATOR
# Virtual/demo game only — no real-money betting.
# ============================================================


# ============================================================
# GAME ENGINE
# ============================================================

class GameEngine:

    def __init__(self):
        self.number = None
        self.colour = None
        self.size = None

    def generate_result(self):

        # Random number from 0 to 9.
        # No prediction pattern or previous-result analysis.
        self.number = secrets.randbelow(10)

        # Colour rules
        if self.number == 0:
            self.colour = "Red + Violet"

        elif self.number == 5:
            self.colour = "Green + Violet"

        elif self.number in [1, 3, 7, 9]:
            self.colour = "Green"

        else:
            self.colour = "Red"

        # Big / Small rules
        if self.number <= 4:
            self.size = "Small"
        else:
            self.size = "Big"

        return self.number, self.colour, self.size


# ============================================================
# MAIN APP
# ============================================================

class WinGoApp(App):

    def build(self):

        self.game = GameEngine()

        # -----------------------------
        # Game variables
        # -----------------------------

        self.round_number = 1
