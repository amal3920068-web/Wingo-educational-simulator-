        )

        self.red_button.bind(
            on_press=lambda x: self.player_selection("Red")
        )

        self.green_button.bind(
            on_press=lambda x: self.player_selection("Green")
        )

        self.violet_button.bind(
            on_press=lambda x: self.player_selection("Violet")
        )

        # ====================================================
        # NUMBER TITLE
        # ====================================================

        number_title = Label(
            text="NUMBER",
            bold=True,
            size_hint_y=None,
            height=30
        )

        content.add_widget(number_title)

        # ====================================================
        # NUMBER GRID
        # ====================================================

        number_grid = GridLayout(
            cols=5,
            spacing=7,
            size_hint_y=None,
            height=100
        )

        self.number_buttons = []

        for i in range(10):

            btn = Button(
                text=str(i),
