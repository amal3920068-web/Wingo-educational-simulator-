            self.number_buttons.append(btn)

            # Remove default Kivy button background
            btn.background_normal = ""
            btn.background_down = ""
            btn.background_color = (0, 0, 0, 0)

            # Number colour rules

            if i == 0:

                self.create_split_color(
                    btn,
                    (0.85, 0.05, 0.05, 1),
                    (0.45, 0.15, 0.75, 1)
                )

            elif i == 5:

                self.create_split_color(
                    btn,
                    (0.05, 0.65, 0.15, 1),
                    (0.45, 0.15, 0.75, 1)
                )

            elif i in [1, 3, 7, 9]:

                self.set_button_color(
                    btn,
                    (0.05, 0.65, 0.15, 1)
                )

            else:

                self.set_button_color(
                    btn,
                    (0.85, 0.05, 0.05, 1)
                )

            btn.bind(
                on_press=lambda instance,
                number=i: self.player_selection(
                    f"Number {number}"
                )
            )

            number_grid.add_widget(btn)

        content.add_widget(number_grid)

        # ====================================================
        # PLAYER SELECTION
        # ====================================================

        selection_title = Label(
            text="YOUR SELECTION",
            bold=True,
            size_hint_y=None,
            height=30
        )

        content.add_widget(selection_title)

        self.selection_label = Label(
            text="None",
            font_size=16,
            size_hint_y=None,
            height=35
