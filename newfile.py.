        )

        content.add_widget(self.history_label)

        # ====================================================
        # ADD CONTENT
        # ====================================================

        root.add_widget(content)

        # ====================================================
        # START GAME
        # ====================================================

        self.start_round()

        return root

    # ========================================================
    # FILLED BUTTON
    # ========================================================

    def set_button_color(self, button, color):

        # Remove Kivy's default button background
        button.background_normal = ""
        button.background_down = ""
        button.background_color = (0, 0, 0, 0)

        with button.canvas.before:

            Color(*color)

            button.bg = RoundedRectangle(
                pos=button.pos,
                size=button.size,
                radius=[10]
            )

        button.bind(
            pos=lambda instance, value:
            setattr(
                button.bg,
                "pos",
                value
            ),

            size=lambda instance, value:
            setattr(
                button.bg,
                "size",
                value
            )
        )

    # ========================================================
    # SPLIT COLOUR BUTTON
    # ========================================================

    def create_split_color(
        self,
        button,
        first_color,
        second_color
    ):

        button.background_normal = ""
        button.background_down = ""
        button.background_color = (0, 0, 0, 0)

        with button.canvas.before:

            # First half
            Color(*first_color)

            button.first_bg = RoundedRectangle(
                pos=button.pos,
                size=(
                    button.width / 2,
                    button.height
                ),
                radius=[10]
            )

            # Second half
            Color(*second_color)

            button.second_bg = RoundedRectangle(
                pos=(
                    button.x + button.width / 2,
                    button.y
                ),
                size=(
                    button.width / 2,
                    button.height
                ),
                radius=[10]
            )

        def update_split(instance, value):

            button.first_bg.pos = button.pos

            button.first_bg.size = (
                button.width / 2,
                button.height
            )

            button.second_bg.pos = (
                button.x + button.width / 2,
                button.y
            )

            button.second_bg.size = (
                button.width / 2,
                button.height
            )

        button.bind(
            pos=update_split,
            size=update_split
        )

    # ========================================================
    # START ROUND
    # ========================================================

    def start_round(self, *args):

        self.seconds_left = 30
        self.player_choice = None

        self.round_label.text = (
            f"Round {self.round_number}"
        )

        self.timer_label.text = "30"

        self.status_label.text = (
            "Select a virtual option"
        )

        self.selection_label.text = "None"

        self.result_label.text = "Waiting..."

        self.debug_label.text = (
            "Result hidden until 10 seconds remain"
        )

        # Generate exactly ONE result
        self.game.generate_result()

        self.enable_buttons()

        # Start timer
        Clock.schedule_interval(
            self.update_timer,
            1
        )

    # ========================================================
    # TIMER
    # ========================================================

    def update_timer(self, dt):

        self.seconds_left -= 1

        self.timer_label.text = str(
            self.seconds_left
        )

        # ----------------------------
        # Developer result
        # ----------------------------

        if self.seconds_left == 10:

            self.show_developer_result()

        # ----------------------------
        # Close selection
        # ----------------------------

        if self.seconds_left == 5:

            self.disable_buttons()

            self.status_label.text = (
                "Selection closed"
            )

        # ----------------------------
        # Publish result
        # ----------------------------

        if self.seconds_left == 0:

            Clock.unschedule(
                self.update_timer
            )

            self.publish_result()

            Clock.schedule_once(
                self.next_round,
                2
            )

    # ========================================================
    # DEVELOPER DEBUG
    # ========================================================

    def show_developer_result(self):

        self.debug_label.text = (
            f"READ ONLY\n"
            f"Number: {self.game.number}\n"
            f"Colour: {self.game.colour}\n"
            f"Size: {self.game.size}"
        )

    # ========================================================
    # PUBLIC RESULT
    # ========================================================

    def publish_result(self):

        self.result_label.text = (
            f"Number: {self.game.number}   |   "
            f"{self.game.colour}   |   "
            f"{self.game.size}"
        )

        self.status_label.text = (
            "Round completed"
        )

        # Save result
        result = {
            "period": self.round_number,
            "number": self.game.number,
            "colour": self.game.colour,
            "size": self.game.size
        }

        self.result_history.insert(
            0,
            result
        )

        # Keep latest 10 results
        self.result_history = (
            self.result_history[:10]
        )

        # Save to JSON
        self.save_history()

        # Update screen
        self.update_history()

    # ========================================================
    # HISTORY DISPLAY
    # ========================================================

    def update_history(self):

        if not hasattr(
            self,
            "history_label"
        ):
            return

        if not self.result_history:

            self.history_label.text = (
                "No results yet."
            )

            return

        text = ""

        for item in self.result_history:

            text += (
                f"Period {item['period']}   "
                f"Number: {item['number']}   "
                f"{item['colour']}   "
                f"{item['size']}\n"
            )

        self.history_label.text = text

    # ========================================================
    # LOAD HISTORY
    # ========================================================

    def load_history(self):

        if not os.path.exists(
            self.history_file
        ):
            self.result_history = []
            return

        try:

            with open(
                self.history_file,
                "r",
                encoding="utf-8"
            ) as file:

                data = json.load(file)

                if isinstance(data, list):

                    self.result_history = data[:10]

                else:

                    self.result_history = []

        except Exception:

            self.result_history = []

    # ========================================================
    # SAVE HISTORY
    # ========================================================

    def save_history(self):

        try:

            with open(
                self.history_file,
                "w",
                encoding="utf-8"
            ) as file:

                json.dump(
                    self.result_history,
                    file,
                    indent=4
                )

        except Exception as error:

            print(
                "History save error:",
                error
            )

    # ========================================================
    # PLAYER SELECTION
    # ========================================================

    def player_selection(self, choice):

        # Selection closed
        if self.seconds_left <= 5:

            self.status_label.text = (
                "Selection is closed"
            )

            return

        self.player_choice = choice

        self.selection_label.text = (
            str(choice)
        )

        self.status_label.text = (
            "Virtual selection recorded"
        )

    # ========================================================
    # DISABLE BUTTONS
    # ========================================================

    def disable_buttons(self):

        self.small_button.disabled = True
        self.big_button.disabled = True

        self.red_button.disabled = True
        self.green_button.disabled = True
        self.violet_button.disabled = True

        for button in self.number_buttons:

            button.disabled = True

    # ========================================================
    # ENABLE BUTTONS
    # ========================================================

    def enable_buttons(self):

        self.small_button.disabled = False
        self.big_button.disabled = False

        self.red_button.disabled = False
        self.green_button.disabled = False
        self.violet_button.disabled = False

        for button in self.number_buttons:

            button.disabled = False

    # ========================================================
    # NEXT ROUND
    # ========================================================

    def next_round(self, dt):

        self.round_number += 1

        self.start_round()


# ============================================================
# RUN APPLICATION
# ============================================================

if __name__ == "__main__":

    WinGoApp().run()